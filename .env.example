# Copy this file to .env and fill the real values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
# Never put secrets here: anything with EXPO_PUBLIC_ ships to the client.

# Base URL of the REST API (must be HTTPS in deployed environments).
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google OAuth client IDs, one per platform (public values).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
